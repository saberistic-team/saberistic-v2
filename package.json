{
  "name": "saberistic-v2",
  "version": "1.0.0",
  "description": "Saberistic V2 — a Payload-powered prototype and engineering platform.",
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "build:site": "cross-env STATIC_CONTENT_MODE=remote pnpm --filter @saberistic/site build",
    "build:site:fixture": "cross-env STATIC_CONTENT_MODE=fixture pnpm --filter @saberistic/site build",
    "verify": "pnpm typecheck && pnpm typecheck:site && pnpm lint && pnpm test:int && pnpm build && pnpm build:site:fixture",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "render:demo": "node scripts/render-warm.mjs --minutes 60",
    "render:warm": "node scripts/render-warm.mjs",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed.ts",
    "seed:preview": "cross-env NODE_OPTIONS=--no-deprecation SEED_PUBLIC_CONCEPTS=true tsx src/scripts/seed.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:gifts:inventory-worker": "cross-env NODE_OPTIONS=\"--no-deprecation --conditions=react-server\" tsx src/lib/gifts/server/inventory-worker.ts",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:gifts:openrouter:live": "cross-env NODE_OPTIONS=--no-deprecation RUN_GIFT_OPENROUTER_LIVE=1 vitest run --config ./vitest.config.mts tests/unit/gifts-openrouter.live.test.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:openrouter:live": "cross-env NODE_OPTIONS=--no-deprecation RUN_OPENROUTER_LIVE=1 vitest run --config ./vitest.config.mts tests/unit/readiness-openrouter.live.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:site": "pnpm --filter @saberistic/site typecheck"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "ioredis": "^6.0.0",
    "next": "16.3.3",
    "payload": "3.88.0",
    "pg": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "stripe": "22.4.0",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.13",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  }
}
