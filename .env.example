DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/saberistic_v2
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
SITE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Static-site builds fetch the Payload snapshot from this server-side URL.
PAYLOAD_PUBLIC_URL=http://localhost:3000
STATIC_CONTENT_MODE=remote

# Optional secret Render Deploy Hook. Keep the real value out of source control.
STATIC_SITE_DEPLOY_HOOK_URL=

# Optional analytics values. Leave URL and ID blank for ordinary local development.
# Production uses https://umami.saberistic.com/script.js and the public Website ID
# recorded in docs/05-umami-analytics-implementation.md.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
UMAMI_TRACK_DOMAINS=saberistic.com,www.saberistic.com

# Production Readiness Check. The assessment always returns its deterministic report.
# AI enhancement stays off unless the required AI values below are configured and the OpenRouter
# key's guardrail/ZDR/budget settings have been verified.
AI_ENHANCEMENT_ENABLED=0
OPENROUTER_API_KEY=
# Shared by readiness and Gift Draft. Set the current policy version only after verifying every
# account/workspace privacy, routing, Guardrail, plugin, model, and spend gate.
OPENROUTER_ACCOUNT_GATES_CONFIRMED=
# Use two distinct canonical provider/model IDs; routers, aliases, and colon variants are rejected.
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_TIMEOUT_MS=12000
OPENROUTER_MAX_COMPLETION_TOKENS=1800

# Gift Draft. Both paths stay off until the corresponding account controls and keys are ready.
# Background inventory research uses the four pinned slots below; research and synthesis may use the
# same exact model when it supports server-side web search and strict structured output.
GIFTING_AI_ENABLED=0
OPENROUTER_GIFT_PRIMARY_MODEL=
OPENROUTER_GIFT_FALLBACK_MODEL=
# Inventory maintenance accepts only pinned provider/model IDs. These may equal the pinned primary
# model when it supports both web research and strict structured output. The request-tail drain uses
# these values; the poll interval applies only to the optional standalone worker command.
OPENROUTER_GIFT_RESEARCH_MODEL=
OPENROUTER_GIFT_INVENTORY_MODEL=
OPENROUTER_GIFT_TIMEOUT_MS=60000
# Three request-tail jobs at 75 seconds leave 75 seconds of overhead under the 300-second route cap.
GIFT_INVENTORY_JOB_TIMEOUT_MS=75000
OPENROUTER_GIFT_MAX_COMPLETION_TOKENS=3000
GIFT_INVENTORY_POLL_MS=5000
# Prefer a restricted Stripe key with write access to create Checkout Sessions and read access to
# retrieve/list Checkout Sessions for return verification and refund-event reconciliation.
GIFTING_CHECKOUT_ENABLED=0
STRIPE_RESTRICTED_KEY=
# Signs Stripe event deliveries sent to /api/gifts/webhook. Keep it separate from API keys.
STRIPE_GIFT_WEBHOOK_SECRET=
# Signs the exact item and observed price returned by the server. Use an independent random secret.
GIFT_QUOTE_SECRET=replace-with-an-independent-32-character-secret
GIFT_QUOTE_TTL_SECONDS=7200

# Paid Architecture Diagnostic. Contact data is collected only after the complete readiness report.
# Keep this off until the restricted Stripe key, webhook, verified Resend sender, and HTTPS booking
# page are configured. The application fixes the price at $200 USD; the browser never supplies it.
DIAGNOSTIC_ENABLED=0
STRIPE_DIAGNOSTIC_RESTRICTED_KEY=
STRIPE_DIAGNOSTIC_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
DIAGNOSTIC_BOOKING_URL=

# Shared abuse and concurrency limits. Use a local Redis/Valkey URL in development;
# Render injects its internal Key Value connection in staging/production.
REDIS_URL=
READINESS_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
READINESS_AI_IP_LIMIT=8
READINESS_AI_TOKEN_LIMIT=4
READINESS_AI_DAILY_LIMIT=200
READINESS_AI_CONCURRENCY_LIMIT=3
READINESS_REJECT_IP_LIMIT=4
READINESS_REJECT_IP_WINDOW_SECONDS=3600
GIFTING_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
GIFTING_IP_LIMIT=8
GIFTING_TOKEN_LIMIT=4
GIFTING_DAILY_LIMIT=50
GIFTING_CONCURRENCY_LIMIT=2
GIFTING_CHECKOUT_IP_LIMIT=20
GIFTING_CHECKOUT_QUOTE_LIMIT=5
GIFTING_STATUS_IP_LIMIT=30
DIAGNOSTIC_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
DIAGNOSTIC_IP_LIMIT=5
DIAGNOSTIC_TOKEN_LIMIT=3
DIAGNOSTIC_DAILY_LIMIT=100

# Signs the short-lived report handoff used by the consented diagnostic funnel. Independent of AI.
READINESS_HANDOFF_SECRET=replace-with-an-independent-32-character-secret
READINESS_HANDOFF_TOKEN_TTL_SECONDS=1800

# Optional one-time seed/bootstrap values. Never commit real credentials.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
SEED_PUBLIC_CONCEPTS=false
