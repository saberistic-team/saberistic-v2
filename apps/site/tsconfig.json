{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "incremental": true,
    "paths": {
      "@/lib/public-content/prototypes": ["./src/lib/static-prototypes.ts"],
      "@/*": ["../../src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../src/app/(frontend)/**/*.tsx",
    "../../src/components/**/*.tsx",
    "../../src/instrumentation-client.ts",
    "../../src/lib/analytics/**/*.ts",
    "../../src/lib/public-content/snapshot.ts",
    "../../src/lib/public-content/types.ts",
    "../../src/types/**/*.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
